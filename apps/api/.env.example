# Copy to .env for local development (do not commit .env)

GLOW_ENVIRONMENT=development
GLOW_SERVICE_NAME=glow-api
GLOW_DATABASE_URL=sqlite+aiosqlite:///./glow.db

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GLOW_AUTH_SECRET_KEY=
GLOW_MASTER_KEY=

# Browser/CORS/cookies
GLOW_AUTH_COOKIE_ENABLED=true
GLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Cross-origin HTTPS deployments: set CORS to your frontend origin, then:
# GLOW_AUTH_COOKIE_SAMESITE=none
# GLOW_AUTH_COOKIE_SECURE=true

# Conversational model
# auto: uses GLOW_LLM_API_BASE if set; else local rule-based fallback in development (not a neural LLM).
# local | openai_compatible | huggingface (explicit) | disabled
GLOW_LLM_PROVIDER=auto
# OpenAI-compatible (vLLM/Ollama/OpenRouter/Groq/HF Router):
# GLOW_LLM_API_BASE=
# GLOW_LLM_API_KEY=
# GLOW_LLM_MODEL_ID=
# Hugging Face Router (explicit opt-in; sends text to configured endpoint):
# GLOW_LLM_PROVIDER=huggingface
# GLOW_HF_TOKEN=
# GLOW_HF_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

# Recommended free chain: Groq primary -> OpenRouter free secondary -> local last resort.
# GLOW_LLM_PROVIDER=openai_compatible
# GLOW_LLM_API_BASE=https://api.groq.com/openai/v1
# GLOW_LLM_API_KEY=<GROQ_API_KEY>
# GLOW_LLM_MODEL_ID=llama-3.3-70b-versatile
# GLOW_LLM_TIMEOUT_SEC=30
# GLOW_LLM_FALLBACK_PROVIDER=openai_compatible
# GLOW_LLM_FALLBACK_API_BASE=https://openrouter.ai/api/v1
# GLOW_LLM_FALLBACK_API_KEY=<OPENROUTER_API_KEY>
# GLOW_LLM_FALLBACK_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free
# GLOW_LLM_LOCAL_FALLBACK_ENABLED=true
#
# Fully local neural option (Ollama, no API key; pull a 3B+ model for usable quality):
# GLOW_LLM_PROVIDER=openai_compatible
# GLOW_LLM_API_BASE=http://127.0.0.1:11434/v1
# GLOW_LLM_API_KEY=ollama
# GLOW_LLM_MODEL_ID=llama3.2:3b
# GLOW_LLM_FALLBACK_PROVIDER=local
# GLOW_LLM_LOCAL_FALLBACK_ENABLED=true
#
# Keyless free demo option (rate-limited; public third-party service - not for
# real user data without consent and a data-processing review):
# GLOW_LLM_API_BASE=https://text.pollinations.ai/openai
# GLOW_LLM_MODEL_ID=openai
# GLOW_LLM_API_KEY=

# Optional web search tool (informational only; docs/web-search.md).
# The curated evidence corpus stays authoritative; search never runs for
# crisis, diagnosis, or medication questions.
# GLOW_WEB_SEARCH_ENABLED=true
# GLOW_SEARCH_PROVIDER=tavily
# GLOW_SEARCH_API_KEY=<tavily-or-brave-free-tier-key>
# GLOW_SEARCH_MAX_RESULTS=3
# GLOW_SEARCH_MAX_PER_SESSION=5
# GLOW_SEARCH_TIMEOUT_SEC=8
