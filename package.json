{
  "name": "glow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @glow/web -- --port 3001",
    "start:api": ".\\.tools\\python313\\Scripts\\uvicorn glow_api.main:app --app-dir apps\\api\\src --host 127.0.0.1 --port 8000 --reload",
    "start:all": "concurrently -k \"npm run dev:web\" \"npm run start:api\"",
    "build:web": "npm run build --workspace @glow/web",
    "lint:web": "npm run lint --workspace @glow/web",
    "typecheck:web": "npm run typecheck --workspace @glow/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "next": "^16.0.0"
  }
}
