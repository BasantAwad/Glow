# Glow API — environment variable reference
#
# Copy this file to .env (which is gitignored) and fill in values for your
# local development environment.  NEVER put real secrets in this file.
#
# All variables use the GLOW_ prefix. See CLAUDE.md §10 for full descriptions.
# Variables not set here use the defaults defined in glow_api/settings.py.

# ---------------------------------------------------------------------------
# Runtime environment
# Allowed: development | test | production   Default: development
# ---------------------------------------------------------------------------
GLOW_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Service name — appears in /healthz and structured logs.
# Default: glow-api
# ---------------------------------------------------------------------------
GLOW_SERVICE_NAME=glow-api

# ---------------------------------------------------------------------------
# DATABASE
# SQLite is LOCAL DEVELOPMENT ONLY.
# PostgreSQL required for any controlled pilot containing real user data.
# Default: sqlite+aiosqlite:///./glow.db
# ---------------------------------------------------------------------------
# GLOW_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/glow

# ---------------------------------------------------------------------------
# AUTHENTICATION (ADR 0002 — Glow-owned HMAC-SHA256 signed JWT)
# Required for any protected endpoint.  Min 32 bytes, hex-encoded.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# When absent, all protected endpoints return 503 ProviderNotConfiguredError.
# ---------------------------------------------------------------------------
# GLOW_AUTH_SECRET_KEY=<64-hex-char string>
# GLOW_AUTH_SECRET_KEY_V2=<new key during rotation — see ADR 0002>

# ---------------------------------------------------------------------------
# ENCRYPTION (Phase 5 — envelope encryption, AES-256-GCM)
# Hex-encoded 32 bytes.  KMS service required for production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
# GLOW_MASTER_KEY=<64-hex-char string>
# GLOW_MASTER_KEY_V2=<new key during rotation>

# ---------------------------------------------------------------------------
# LLM GATEWAY (Phase 6A — OpenAI-compatible vLLM endpoint)
# Requires a running vLLM instance serving Qwen/Qwen2.5-14B-Instruct (or
# another approved open-weights model).
# ---------------------------------------------------------------------------
# GLOW_LLM_API_BASE=http://localhost:8000/v1
# GLOW_LLM_API_KEY=<vLLM API key if auth is enabled>
# GLOW_LLM_MODEL_ID=Qwen/Qwen2.5-14B-Instruct
# GLOW_LLM_MAX_TOKENS=512

# ---------------------------------------------------------------------------
# STT (Phase 6B — faster-whisper)
# Model size: tiny | base | small | medium | large-v3
# Device: auto | cuda | cpu
# ---------------------------------------------------------------------------
# WHISPER_MODEL_SIZE=large-v3
# WHISPER_DEVICE=auto

# ---------------------------------------------------------------------------
# AVATAR (Phase 10 — Audio2Face-3D, BLOCKED — 18 blockers unresolved)
# ---------------------------------------------------------------------------
# GLOW_NVIDIA_API_KEY=<NVIDIA Cloud Functions API key>

# ---------------------------------------------------------------------------
# HUGGING FACE (optional — model downloads)
# ---------------------------------------------------------------------------
# GLOW_HF_TOKEN=<HuggingFace access token>

# ---------------------------------------------------------------------------
# TEST FLAGS
# Set ENABLE_LIVE_PROVIDER_TESTS=1 to run tests that call real providers.
# This requires real running services (vLLM, STT, TTS).
# ---------------------------------------------------------------------------
# ENABLE_LIVE_PROVIDER_TESTS=0

# Paymob payment gateway (Egypt)
GLOW_PAYMOB_SECRET_KEY=
GLOW_PAYMOB_PUBLIC_KEY=
GLOW_PAYMOB_HMAC_SECRET=
GLOW_PAYMOB_INTEGRATION_ID=
