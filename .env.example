# Glow local/development environment example
# Copy to .env (repo root) or apps/api/.env and fill values as needed.
# Never commit real secrets.

# --- Runtime ---
GLOW_ENVIRONMENT=development
GLOW_SERVICE_NAME=glow-api

# --- Database ---
# SQLite persists across restarts in local development.
GLOW_DATABASE_URL=sqlite+aiosqlite:///./glow.db
# Production/pilot example (PostgreSQL):
# GLOW_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/glow

# --- Auth (required for protected endpoints) ---
# Hex-encoded secret, minimum 32 bytes (64 hex chars recommended).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GLOW_AUTH_SECRET_KEY=
# Optional rotation key:
# GLOW_AUTH_SECRET_KEY_V2=

# --- Encryption (recommended; required for encrypted transcript/journal flows) ---
# Hex-encoded 32-byte AES key. Generate same way as auth secret.
GLOW_MASTER_KEY=
# GLOW_MASTER_KEY_V2=

# --- Browser/CORS/cookies ---
# Comma-separated origins. Leave unset in development for localhost defaults.
# Production / cross-origin deployments must set this.
# Same-origin Vercel deployment (Services) uses a relative path instead:
# NEXT_PUBLIC_API_URL=/api
# GLOW_CORS_ORIGINS=https://your-frontend.example.com
GLOW_AUTH_COOKIE_ENABLED=true
# For cross-origin HTTPS deployments, use: SameSite=none and Secure=true.
GLOW_AUTH_COOKIE_SAMESITE=lax
# GLOW_AUTH_COOKIE_SECURE=true

# --- LLM / conversational agent ---
# auto: uses GLOW_LLM_API_BASE if set; otherwise uses local context engine in development.
#       (local is a rule-based fallback, not a clinical/neural LLM; useful for dev/offline.)
# local: explicit in-process fallback.
# openai_compatible: any OpenAI-compatible chat API (vLLM, Ollama /v1, OpenRouter, Groq, HF Router).
# huggingface: Hugging Face Router (requires HF token/model; explicit opt-in - sends session text to configured endpoint).
# disabled: fail clearly when model is unavailable.
GLOW_LLM_PROVIDER=auto
# OpenAI-compatible example (OpenRouter/Groq/Ollama/vLLM):
# GLOW_LLM_API_BASE=https://openrouter.ai/api/v1
# GLOW_LLM_API_KEY=
# GLOW_LLM_MODEL_ID=
# Hugging Face Router example (explicit):
# GLOW_LLM_PROVIDER=huggingface
# GLOW_HF_TOKEN=
# GLOW_HF_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

# --- Recommended free fallback chain ---
# Primary: Groq (fast, free tier). Secondary: OpenRouter free model.
# Final: local rule-based engine (last resort; enabled by default).
# GLOW_LLM_PROVIDER=openai_compatible
# GLOW_LLM_API_BASE=https://api.groq.com/openai/v1
# GLOW_LLM_API_KEY=<GROQ_API_KEY>
# GLOW_LLM_MODEL_ID=llama-3.3-70b-versatile
# GLOW_LLM_TIMEOUT_SEC=30
#
# GLOW_LLM_FALLBACK_PROVIDER=openai_compatible
# GLOW_LLM_FALLBACK_API_BASE=https://openrouter.ai/api/v1
# GLOW_LLM_FALLBACK_API_KEY=<OPENROUTER_API_KEY>
# GLOW_LLM_FALLBACK_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free
#
# GLOW_LLM_LOCAL_FALLBACK_ENABLED=true
#
# --- Fully local neural option (Ollama, no API key) ---
# Requires Ollama running locally with a model pulled, e.g. `ollama pull llama3.2:3b`.
# Prefer 3B+ models; 0.5B models are fast but too weak for supportive conversation.
# GLOW_LLM_PROVIDER=openai_compatible
# GLOW_LLM_API_BASE=http://127.0.0.1:11434/v1
# GLOW_LLM_API_KEY=ollama
# GLOW_LLM_MODEL_ID=llama3.2:3b
# GLOW_LLM_FALLBACK_PROVIDER=local
# GLOW_LLM_LOCAL_FALLBACK_ENABLED=true
#
# Keyless free demo option (rate-limited; public third-party service - do not
# use with real user data without consent and a data-processing review):
# GLOW_LLM_API_BASE=https://text.pollinations.ai/openai
# GLOW_LLM_MODEL_ID=openai
# GLOW_LLM_API_KEY=

# --- Optional voice/avatar providers (not required for core text + journal + games) ---
# GLOW_STT_MODEL_ID=base
# GLOW_TTS_MODEL_ID=
# GLOW_TTS_VOICE_ID=
# GLOW_TAVUS_API_KEY=
# GLOW_TAVUS_REPLICA_ID=
# GLOW_TAVUS_PERSONA_ID=
