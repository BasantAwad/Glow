# Glow API — environment variable reference
#
# Copy this file to .env (which is gitignored) and fill in the values for
# your local development environment.  Never put real secrets in this file.
#
# All variables use the GLOW_ prefix (SettingsConfigDict env_prefix in
# glow_api/settings.py).  Only non-sensitive configuration is listed here;
# secrets (API keys, database passwords, JWT signing keys) must be supplied
# via a secret manager or a local .env file that is never committed.
#
# Variables not set here will use the defaults defined in settings.py.

# ---------------------------------------------------------------------------
# Runtime environment — controls logging verbosity, debug features, and
# behaviour that differs between development and production.
# Allowed values: development | test | production
# Default: development
# ---------------------------------------------------------------------------
GLOW_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Service name — appears in /healthz responses and structured log fields.
# Override in test environments to distinguish instances.
# Default: glow-api
# ---------------------------------------------------------------------------
GLOW_SERVICE_NAME=glow-api

# ---------------------------------------------------------------------------
# DATABASE (Phase 1 — not yet implemented)
# When a PostgreSQL provider is selected and reviewed, add:
#   GLOW_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/glow
# Never commit a real DATABASE_URL.  Use a secret manager in production.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AUTHENTICATION (Phase 1 — not yet implemented)
# When an auth provider is selected and reviewed, add the relevant variables
# here (e.g. GLOW_AUTH_ISSUER, GLOW_AUTH_AUDIENCE).
# Never commit signing keys or client secrets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MODEL GATEWAY (Phase 3 — not yet implemented)
# When a model provider is selected, reviewed, and contracted, add:
#   GLOW_MODEL_PROVIDER_API_KEY=<secret — use secret manager, not .env>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AVATAR GATEWAY (Phase 7 / Audio2Face)
# ---------------------------------------------------------------------------
# GLOW_NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# ENCRYPTION (Phase 5)
# ---------------------------------------------------------------------------
# GLOW_MASTER_KEY=

